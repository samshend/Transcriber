<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Entitlements for the bundled command-line tools (ffmpeg, whisper-cli). A sandboxed
  app may only spawn a child that itself opts into the sandbox and inherits the
  parent's container. Without `inherit`, macOS refuses to launch the helper.
-->
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>

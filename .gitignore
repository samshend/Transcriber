# ── macOS / Swift app (mac/) ─────────────────────────────────────────
# SwiftPM build output and local IDE state (Xcode may regenerate .swiftpm at any root)
/mac/.build/
.swiftpm/
# Packaged app + DMG (regenerated by Scripts/build-app.sh)
/mac/build/
# Bundled native binaries — whisper-cli, whisper-server, llama-server, ffmpeg.
# Rebuilt via mac/Scripts/build-whisper.sh, build-llama.sh, bundle-tools.sh.
/mac/vendor/

# ── Windows / .NET app (windows/) ────────────────────────────────────
[Bb]in/
[Oo]bj/
# First-run model downloads staged by scripts/fetch-assets.ps1
/windows/models/
# Native tool assets fetched at build time (ffmpeg.exe, whisper-cli.exe, …)
/windows/assets/
# Local publish and installer outputs (regenerated by packaging scripts)
/windows/artifacts/

# ── OS / editor cruft ────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Transcriber.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Transcriber.App.ViewModels"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    Title="Transcriber">

    <Grid ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Column 0: projects sidebar -->
        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="NavList"
                      Grid.Row="0"
                      ItemsSource="{x:Bind Vm.Nav}"
                      SelectionChanged="NavList_SelectionChanged"
                      Padding="4,8">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavNode">
                        <Border AllowDrop="{x:Bind AcceptsDrop}"
                                DragOver="Nav_DragOver"
                                Drop="Nav_Drop"
                                Background="Transparent"
                                Padding="8,6">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="1" Content="New Project" Click="NewProject_Click"
                    HorizontalAlignment="Stretch" Margin="8" />
        </Grid>

        <!-- Column 1: transcript list -->
        <Grid Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Vm.SelectionTitle, Mode=OneWay}"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="Import_Click" ToolTipService.ToolTip="Import an audio or video file">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressBar Grid.Row="1" IsIndeterminate="True"
                         Visibility="{x:Bind Vm.IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}" />

            <ListView x:Name="ItemsList"
                      Grid.Row="2"
                      ItemsSource="{x:Bind Vm.Items}"
                      SelectionChanged="ItemsList_SelectionChanged"
                      CanDragItems="True"
                      DragItemsStarting="ItemsList_DragItemsStarting"
                      Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TranscriptItemViewModel">
                        <Grid Padding="6,6" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Visibility="{x:Bind ShowProjectBadge, Converter={StaticResource BoolToVis}}"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        CornerRadius="8" Padding="6,1">
                                    <TextBlock Text="{x:Bind ProjectName, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <FontIcon Glyph="&#xE7BA;" FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          Visibility="{x:Bind HasWarning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open Transcript" Click="Open_Click" />
                                    <MenuFlyoutSubItem Text="Export">
                                        <MenuFlyoutItem Text="Save Transcript to Downloads" Click="ExportTranscriptDownloads_Click" />
                                        <MenuFlyoutItem Text="Save Transcript As…" Click="ExportTranscriptAs_Click" />
                                        <MenuFlyoutItem Text="Save Audio to Downloads" Click="ExportAudioDownloads_Click"
                                                        Visibility="{x:Bind HasAudio, Converter={StaticResource BoolToVis}}" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Text="Rename…" Click="Rename_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete Permanently" Click="Delete_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Column 2: detail -->
        <ScrollViewer Grid.Column="2">
            <StackPanel Padding="20" Spacing="12">
                <TextBlock x:Name="DetailTitle" Style="{ThemeResource TitleTextBlockStyle}"
                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailMeta" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <InfoBar x:Name="DetailWarning" Severity="Warning" IsOpen="False" IsClosable="False" />

                <MediaPlayerElement x:Name="AudioPlayer"
                                    AreTransportControlsEnabled="True"
                                    Visibility="Collapsed"
                                    MaxHeight="60" />

                <TextBlock x:Name="DetailBody" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           LineHeight="24" />

                <StackPanel x:Name="EmptyDetail" Spacing="8" HorizontalAlignment="Center" Margin="0,80,0,0">
                    <FontIcon Glyph="&#xE8A5;" FontSize="40"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Select a transcript"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Transcriber.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Transcriber.App.ViewModels"
    xmlns:mux="using:Microsoft.UI.Xaml.Controls"
    Title="Transcriber">

    <Grid ColumnSpacing="0" DataContext="{x:Bind Vm}" AllowDrop="True"
          DragOver="Window_DragOver" Drop="Window_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Primary actions and live recording state. Recording is intentionally impossible to
             miss: while active, controls replace the idle toolbar across the whole window. -->
        <Border Grid.Row="0" Grid.ColumnSpan="3"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                Background="{ThemeResource LayerFillColorAltBrush}" Padding="12,8">
            <Grid>
                <StackPanel x:Name="IdleRecordingControls" Orientation="Horizontal" Spacing="10">
                    <Button Click="StartRecording_Click" ToolTipService.ToolTip="Record microphone and system audio">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xEA3A;" Foreground="Red" FontSize="16" />
                            <TextBlock Text="Record" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Record a meeting or conversation" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Click="Settings_Click" Content="Settings" />
                    <Button Click="OpenLogs_Click" Content="Logs" />
                    <TextBlock Text="{Binding StatusMessage, Mode=OneWay}" VerticalAlignment="Center"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>

                <Grid x:Name="ActiveRecordingControls" Visibility="Collapsed" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="RecordingDot" Glyph="&#xEA3A;" Foreground="Red" FontSize="16"
                              VerticalAlignment="Center" />
                    <TextBlock x:Name="RecordingTime" Grid.Column="1" Text="00:00" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <ProgressBar x:Name="MicLevel" Grid.Column="2" Minimum="0" Maximum="100" Value="0"
                                 VerticalAlignment="Center" Height="8" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock x:Name="RecordingSource" Text="Microphone + system audio" />
                        <TextBlock x:Name="RecordingWarningText" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="PauseRecordingButton" Grid.Column="4" Click="PauseRecording_Click" Content="Pause" />
                    <Button x:Name="DiscardRecordingButton" Grid.Column="5" Click="DiscardRecording_Click" Content="Discard" />
                    <Button x:Name="StopRecordingButton" Grid.Column="6" Click="StopRecording_Click"
                            Content="Stop &amp; transcribe" Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Column 0: projects sidebar -->
        <Grid Grid.Row="1" Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="NavList"
                      Grid.Row="0"
                      ItemsSource="{x:Bind Vm.Nav}"
                      SelectionChanged="NavList_SelectionChanged"
                      Padding="4,8">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NavNode">
                        <Border AllowDrop="{x:Bind AcceptsDrop}"
                                DragOver="Nav_DragOver"
                                Drop="Nav_Drop"
                                Background="Transparent"
                                Padding="8,6">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="1" Content="New Project" Click="NewProject_Click"
                    HorizontalAlignment="Stretch" Margin="8" />
        </Grid>

        <!-- Column 1: transcript list -->
        <Grid Grid.Row="1" Grid.Column="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Vm.SelectionTitle, Mode=OneWay}"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Click="Import_Click" ToolTipService.ToolTip="Import an audio or video file">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Padding="12,4,12,10" Spacing="6"
                        Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ProcessingDetail, Mode=OneWay}"
                               FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="1" Content="Stop transcription"
                            IsEnabled="{Binding CanCancelProcessing, Mode=OneWay}"
                            Click="CancelProcessing_Click" />
                </Grid>
                <ProgressBar Minimum="0" Maximum="100"
                             Value="{Binding ProcessingProgress, Mode=OneWay}" />
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Prepare" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="Transcribe" FontSize="10" TextAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Speakers" FontSize="10" TextAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="Save" FontSize="10" TextAlignment="Right" />
                </Grid>
            </StackPanel>

            <ListView x:Name="ItemsList"
                      Grid.Row="2"
                      ItemsSource="{x:Bind Vm.Items}"
                      SelectionChanged="ItemsList_SelectionChanged"
                      CanDragItems="True"
                      DragItemsStarting="ItemsList_DragItemsStarting"
                      Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TranscriptItemViewModel">
                        <Grid Padding="6,6" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border Visibility="{Binding ShowProjectBadge, Converter={StaticResource BoolToVis}}"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        CornerRadius="8" Padding="6,1">
                                    <TextBlock Text="{x:Bind ProjectName, Mode=OneWay}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <FontIcon Glyph="&#xE7BA;" FontSize="12"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                          Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open Transcript" Click="Open_Click" />
                                    <MenuFlyoutSubItem Text="Export">
                                        <MenuFlyoutItem Text="Save Transcript to Downloads" Click="ExportTranscriptDownloads_Click" />
                                        <MenuFlyoutItem Text="Save Transcript As…" Click="ExportTranscriptAs_Click" />
                                        <MenuFlyoutItem Text="Save Audio to Downloads" Click="ExportAudioDownloads_Click"
                                                        Visibility="{Binding HasAudio, Converter={StaticResource BoolToVis}}" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Text="Rename…" Click="Rename_Click" />
                                    <MenuFlyoutItem Text="Rename Speakers…" Click="RenameSpeakers_Click"
                                                    Visibility="{Binding HasSpeakers, Converter={StaticResource BoolToVis}}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete Permanently" Click="Delete_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Column 2: detail -->
        <ScrollViewer Grid.Row="1" Grid.Column="2">
            <StackPanel Padding="20" Spacing="12">
                <TextBlock x:Name="DetailTitle" Style="{ThemeResource TitleTextBlockStyle}"
                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                <TextBlock x:Name="DetailMeta" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="DetailActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button Click="RevealInExplorer_Click" ToolTipService.ToolTip="Show transcript in File Explorer">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE838;" FontSize="14" />
                            <TextBlock Text="Explorer" />
                        </StackPanel>
                    </Button>
                    <Button Click="CopyTranscript_Click" ToolTipService.ToolTip="Copy transcript text">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                            <TextBlock Text="Copy Transcript" />
                        </StackPanel>
                    </Button>
                    <Button ToolTipService.ToolTip="More transcript actions">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE712;" FontSize="14" />
                                <TextBlock Text="More" />
                            </StackPanel>
                        </Button.Content>
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Open Transcript" Click="Open_Click" />
                                <MenuFlyoutSubItem Text="Export">
                                    <MenuFlyoutItem Text="Save Transcript to Downloads" Click="ExportTranscriptDownloads_Click" />
                                    <MenuFlyoutItem Text="Save Transcript As…" Click="ExportTranscriptAs_Click" />
                                    <MenuFlyoutItem Text="Save Audio to Downloads" Click="ExportAudioDownloads_Click"
                                                    Visibility="{Binding SelectedItem.HasAudio, Converter={StaticResource BoolToVis}}" />
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem Text="Rename…" Click="Rename_Click" />
                                <MenuFlyoutItem Text="Rename Speakers…" Click="RenameSpeakers_Click"
                                                Visibility="{Binding SelectedItem.HasSpeakers, Converter={StaticResource BoolToVis}}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete Permanently" Click="Delete_Click" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <InfoBar x:Name="DetailWarning" Severity="Warning" IsOpen="False" IsClosable="False" />

                <MediaPlayerElement x:Name="AudioPlayer"
                                    AreTransportControlsEnabled="True"
                                    Visibility="Collapsed"
                                    Height="96">
                    <MediaPlayerElement.TransportControls>
                        <!-- WinUI's full transport layout includes the seek/progress bar,
                             elapsed/remaining time, play/pause, and volume controls. -->
                        <MediaTransportControls IsCompact="False" />
                    </MediaPlayerElement.TransportControls>
                </MediaPlayerElement>
                <InfoBar x:Name="PlaybackError" Severity="Error" IsOpen="False"
                         IsClosable="True" Title="Audio playback failed" />

                <TextBlock x:Name="DetailBody" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           LineHeight="24" />

                <StackPanel x:Name="EmptyDetail" Spacing="8" HorizontalAlignment="Center" Margin="0,80,0,0">
                    <FontIcon Glyph="&#xE8A5;" FontSize="40"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Select a transcript"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
